# The bundle staged by ci/bundle-*.sh: the executable, or a wrapper script,
# plus its relocated libraries.
recursive-include src/gwyddionpy_converter/bin *
# Windows only. Its module lookup resolves plugins at
# <package>/lib/gwyddion/modules, a sibling of bin/ rather than inside it;
# ci/bundle-windows.sh explains why. Empty on Linux and macOS, where the
# modules live under bin/.
recursive-include src/gwyddionpy_converter/lib *
